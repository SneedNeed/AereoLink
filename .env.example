# Copia este archivo como ".env" y ajusta los valores a tu PostgreSQL.

# --- Conexión a PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aerolink
DB_USER=postgres
DB_PASSWORD=tu_contraseña

# (Opcional) En vez de lo anterior puedes usar una sola URL:
# DATABASE_URL=postgresql://postgres:tu_contraseña@localhost:5432/aerolink

# --- Servidor web ---
PORT=3000

# Clave para firmar las sesiones. Pon cualquier texto largo y secreto.
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Solo si publicas el sitio con HTTPS:
# COOKIE_SECURE=true
